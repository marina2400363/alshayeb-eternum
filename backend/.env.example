PORT=5000
NODE_ENV=development

# MongoDB Atlas only. Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/alshayeb-eternum?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated frontend origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Cloudinary payment proof screenshot storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email — legacy Experience/Rooms senders and the
# Season 2 lifecycle in src/utils/season2Email.js). Leaving this empty
# disables sending everywhere; nothing else in the app depends on it.
RESEND_API_KEY=

# --- Rate limiting + sync-trigger protection (Season 2 hardening) ---------
# RATE_LIMIT_MODE: enforce (default) | log (count + log, never block) | off.
RATE_LIMIT_MODE=enforce
# Key used to HMAC-hash rate-limit identities (phones/emails/IPs are never
# stored). Optional: falls back to JWT_SECRET when empty.
RATE_LIMIT_SECRET=
# Required for GET /api/cron/sync-all and GET /api/rooms/force-sync. Sent as
# "Authorization: Bearer <CRON_SECRET>". Use 32+ random characters (min 16).
# Must match the CRON_SECRET GitHub Actions secret used by
# .github/workflows/cron-sync.yml. Unset/short => those endpoints answer 503.
CRON_SECRET=
